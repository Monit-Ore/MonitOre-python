import csv
from datetime import datetime
import os
import time
import psutil

# definicao dos nomes dos ficheiros csv
ARQUIVO_HARDWARE = "./CAPTURA_HARDWARE.csv"
ARQUIVO_PROCESSOS = "./CAPTURA_PROCESSOS.csv"


# funcao para verificar se o ficheiro necessita de cabecalho
def precisa_cabecalho(caminho):
    return not os.path.exists(caminho) or os.path.getsize(caminho) == 0


print("=" * 60)
print("MONITOR ORE - CAPTURA SEPARADA (HARDWARE E PROCESSOS)")
print("=" * 60)
identificador_torre = input("qual o nome da torre? ").strip()
identificador_servidor = input("qual o servidor da torre? ").strip()

# contagem de processadores logicos e memoria fisica total
processadores_virtuais = psutil.cpu_count(logical=True) or 1
memoria_sistema = psutil.virtual_memory()
ram_total_mb = round(memoria_sistema.total / (1024 * 1024), 2)

# cabecalho da tabela de hardware (nivel de servidor)
cabecalho_hardware = [
    "RODADA",
    "TORRE",
    "SERVIDOR",
    "DATA",
    "HORA",
    "CPU_TOTAL_PCT",
    "RAM_TOTAL_PCT",
    "RAM_TOTAL_MB",
    "DISCO_TOTAL_PCT",
]

# cabecalho da tabela de processos (relacionada pela rodada)
cabecalho_processos = [
    "RODADA",
    "TORRE",
    "SERVIDOR",
    "DATA",
    "HORA",
    "PID",
    "PROCESSO",
    "PROC_CPU_ABSOLUTA_PCT",
    "PROC_CPU_GLOBAL_PCT",
    "PROC_RAM_PCT",
    "PROC_RAM_MB",
]

# verificacao inicial de cabecalho
escrever_cabecalho_hw = precisa_cabecalho(ARQUIVO_HARDWARE)
escrever_cabecalho_proc = precisa_cabecalho(ARQUIVO_PROCESSOS)
numero_rodada = 1

print()
print("=" * 60)
print("MONITORAMENTO INICIADO")
print(f"torre        : {identificador_torre}")
print(f"servidor     : {identificador_servidor}")
print(f"cpus lógicas : {processadores_virtuais}")
print(f"ram total    : {ram_total_mb:.2f} mb")
print("=" * 60)

try:
    with open(
        ARQUIVO_HARDWARE, "a", newline="", encoding="utf-8-sig"
    ) as f_hw, open(
        ARQUIVO_PROCESSOS, "a", newline="", encoding="utf-8-sig"
    ) as f_proc:

        escritor_hw = csv.writer(f_hw, delimiter=";")
        escritor_proc = csv.writer(f_proc, delimiter=";")

        # gravacao dos cabecalhos se os ficheiros forem novos
        if escrever_cabecalho_hw:
            escritor_hw.writerow(cabecalho_hardware)
            f_hw.flush()

        if escrever_cabecalho_proc:
            escritor_proc.writerow(cabecalho_processos)
            f_proc.flush()

        while True:
            # medicao global do sistema (hardware)
            cpu_total_pct = psutil.cpu_percent(interval=1)
            mem = psutil.virtual_memory()
            ram_total_pct = mem.percent
            raiz_disco = os.path.abspath(os.sep)
            disco_total_pct = psutil.disk_usage(raiz_disco).percent

            agora = datetime.now()
            data = agora.strftime("%d/%m/%Y")
            hora = agora.strftime("%H:%M:%S")

            # linha da metrica de hardware (uma unica linha por rodada)
            linha_hw = [
                numero_rodada,
                identificador_torre,
                identificador_servidor,
                data,
                hora,
                round(cpu_total_pct, 2),
                round(ram_total_pct, 2),
                ram_total_mb,
                round(disco_total_pct, 2),
            ]
            escritor_hw.writerow(linha_hw)
            f_hw.flush()

            # medicao de processos da rodada
            total_processos = 0

            for proc in psutil.process_iter(
                ["pid", "name", "cpu_percent", "memory_info", "memory_percent"]
            ):
                try:
                    info = proc.info
                    pid = info["pid"]

                    # ignora o idle do sistema e processos vazios
                    if pid == 0 or info["name"] == "System Idle Process":
                        continue

                    nome_processo = info["name"]
                    proc_cpu_absoluta = info["cpu_percent"] or 0.0
                    proc_cpu_global = (
                        proc_cpu_absoluta / processadores_virtuais
                    )
                    proc_ram_mb = (info["memory_info"].rss or 0) / (1024 * 1024)
                    proc_ram_pct = info["memory_percent"] or 0.0

                    linha_proc = [
                        numero_rodada,
                        identificador_torre,
                        identificador_servidor,
                        data,
                        hora,
                        pid,
                        nome_processo,
                        round(proc_cpu_absoluta, 2),
                        round(proc_cpu_global, 2),
                        round(proc_ram_pct, 2),
                        round(proc_ram_mb, 2),
                    ]

                    escritor_proc.writerow(linha_proc)
                    total_processos += 1

                except (
                    psutil.NoSuchProcess,
                    psutil.AccessDenied,
                    psutil.ZombieProcess,
                ):
                    continue

            f_proc.flush()

            print(
                f"rodada #{numero_rodada} registada: 1 linha em hardware e {total_processos} processos gravados."
            )
            numero_rodada += 1
            time.sleep(9)

except KeyboardInterrupt:
    print("\ncaptura finalizada pelo utilizador.")