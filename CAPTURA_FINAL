import csv
from datetime import datetime

# manipulacao de caminhos e recursos do SO
import os
import time
import psutil

# nomezao que vai aparecer no arquivo
ARQUIVO_CSV = "./CAPTURA_FINALIZADA.csv"


# funcao pra verificar se o arquivo vai precisar de cabecalho
def arquivo_precisa_cabecalho(caminho):
    return not os.path.exists(caminho) or os.path.getsize(caminho) == 0


# pedido dos nomes dos servidores e torres
#NAO SEI SE PRECISA MAS COLOQUEI
print("=" * 60)
print("MONITOR ORE - CAPTURA RELACIONAL DE PROCESSOS")
print("=" * 60)
identificador_torre = input("qual o nome da torre? ").strip()
identificador_servidor = input("qual o servidor da torre? ").strip()

# contagem de nucleos e memoria total fisica em MB
processadores_virtuais = psutil.cpu_count(logical=True) or 1
memoria_sistema = psutil.virtual_memory()
ram_total_mb = round(memoria_sistema.total / (1024 * 1024), 2)

# definicao das coluna
cabecalho = [
    "RODADA",
    "TORRE",
    "SERVIDOR",
    "DATA",
    "HORA",
    "CPU_TOTAL_PCT",
    "RAM_TOTAL_PCT",
    "RAM_TOTAL_MB",
    "DISCO_TOTAL_PCT",
    "PID",
    "PROCESSO",
    "PROC_CPU_ABSOLUTA_PCT",
    "PROC_CPU_GLOBAL_PCT",
    "PROC_RAM_PCT",
    "PROC_RAM_MB",
]

precisa_cabecalho = arquivo_precisa_cabecalho(ARQUIVO_CSV)
numero_rodada = 1

print()
print("=" * 60)
print("MONITORAMENTO INICIADO")
print(f"torre        : {identificador_torre}")
print(f"servidor     : {identificador_servidor}")
print(f"cpus lógicas : {processadores_virtuais}")
print(f"ram total    : {ram_total_mb:.2f} mb")
print("=" * 60)

try:
    with open(
        ARQUIVO_CSV, "a", newline="", encoding="utf-8-sig"
    ) as arquivo_csv:
        escritor = csv.writer(arquivo_csv, delimiter=";")

        if precisa_cabecalho:
            escritor.writerow(cabecalho)
            arquivo_csv.flush()
            precisa_cabecalho = False

        while True:
            # medicao global do sistema
            cpu_total_pct = psutil.cpu_percent(interval=1)
            mem = psutil.virtual_memory()
            ram_total_pct = mem.percent
            raiz_disco = os.path.abspath(os.sep)
            disco_total_pct = psutil.disk_usage(raiz_disco).percent

            agora = datetime.now()
            data = agora.strftime("%d/%m/%Y")
            hora = agora.strftime("%H:%M:%S")

            total_processos = 0

            for proc in psutil.process_iter(
                ["pid", "name", "cpu_percent", "memory_info", "memory_percent"]
            ):
                try:
                    info = proc.info
                    pid = info["pid"]

                    # IGNORA O PID 0 "System Idle Process" e processos sem nome
                    if pid == 0 or info["name"] == "System Idle Process":
                        continue

                    nome_processo = info["name"]
                    proc_cpu_absoluta = info["cpu_percent"] or 0.0

                    # calcula quanto o processo consome da capacidade total do processador
                    proc_cpu_global = proc_cpu_absoluta / processadores_virtuais

                    # memoria ram utilizada em MB e percentual
                    proc_ram_mb = (info["memory_info"].rss or 0) / (1024 * 1024)
                    proc_ram_pct = info["memory_percent"] or 0.0

                    linha = [
                        numero_rodada,
                        identificador_torre,
                        identificador_servidor,
                        data,
                        hora,
                        round(cpu_total_pct, 2),
                        round(ram_total_pct, 2),
                        ram_total_mb,
                        round(disco_total_pct, 2),
                        pid,
                        nome_processo,
                        round(proc_cpu_absoluta, 2),
                        round(proc_cpu_global, 2),
                        round(proc_ram_pct, 2),
                        round(proc_ram_mb, 2),
                    ]

                    escritor.writerow(linha)
                    total_processos += 1

                except (
                    psutil.NoSuchProcess,
                    psutil.AccessDenied,
                    psutil.ZombieProcess,
                ):
                    continue

            # linha em branco entre capturas para separacao visual 
            escritor.writerow([])
            arquivo_csv.flush()

            print(
                f"rodada #{numero_rodada} concluida com {total_processos} processos."
            )
            numero_rodada += 1
            time.sleep(9)

except KeyboardInterrupt:
    print("\ncaptura finalizada pelo utilizador.")