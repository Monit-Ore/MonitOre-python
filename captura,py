import csv
import os
import socket
import time
from datetime import datetime

import psutil

ARQUIVO_HARDWARE = "./CAPTURA_HARDWARE.csv"
ARQUIVO_PROCESSOS = "./CAPTURA_PROCESSOS.csv"

TOTAL_REGISTROS_LIMITE = 50
INTERVALO_SEGUNDOS = 9


CABECALHO_HARDWARE = [
    "RODADA",
    "PC_INDUSTRIAL",
    "DATA",
    "HORA",
    "CPU_TOTAL_PCT",
    "RAM_TOTAL_PCT",
    "RAM_TOTAL_MB",
    "DISCO_TOTAL_PCT",
    "QTD_PROCESSOS",
]

CABECALHO_PROCESSOS = [
    "RODADA",
    "PC_INDUSTRIAL",
    "DATA",
    "HORA",
    "PID",
    "PROCESSO",
    "PROC_CPU_ABSOLUTA_PCT",
    "PROC_CPU_GLOBAL_PCT",
    "PROC_RAM_PCT",
    "PROC_RAM_MB",
]


def precisa_cabecalho(caminho):
    return (
        not os.path.exists(caminho)
        or os.path.getsize(caminho) == 0
    )


def validar_arquivo_csv(caminho, cabecalho_esperado):
    if precisa_cabecalho(caminho):
        return

    with open(
        caminho,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as arquivo:
        leitor = csv.reader(arquivo, delimiter=";")
        cabecalho_atual = next(leitor, [])

    if cabecalho_atual != cabecalho_esperado:
        raise ValueError(
            f"O arquivo {caminho} possui um cabecalho diferente "
            "do esperado. Faca backup ou renomeie o arquivo antigo "
            "antes de iniciar uma nova captura."
        )


def obter_processos(
    numero_rodada,
    identificador_pc_industrial,
    data,
    hora,
    processadores_virtuais,
):
    linhas_processos = []

    for processo in psutil.process_iter(
        [
            "pid",
            "name",
            "cpu_percent",
            "memory_info",
            "memory_percent",
        ]
    ):
        try:
            info = processo.info

            pid = info["pid"]
            nome_processo = info["name"] or "Desconhecido"

            cpu_absoluta = info["cpu_percent"] or 0.0
            cpu_global = cpu_absoluta / processadores_virtuais

            memoria = info["memory_info"]

            ram_mb = (
                memoria.rss / (1024 * 1024)
                if memoria
                else 0.0
            )

            ram_pct = info["memory_percent"] or 0.0

            linhas_processos.append([
                numero_rodada,
                identificador_pc_industrial,
                data,
                hora,
                pid,
                nome_processo,
                round(cpu_absoluta, 2),
                round(cpu_global, 2),
                round(ram_pct, 2),
                round(ram_mb, 2),
            ])

        except (
            psutil.NoSuchProcess,
            psutil.AccessDenied,
            psutil.ZombieProcess,
        ):
            continue

    return linhas_processos


def obter_uso_disco():
    """
    Calcula o uso total dos volumes locais acessiveis,
    evitando contar o mesmo dispositivo mais de uma vez.
    """
    total_bytes = 0
    usado_bytes = 0
    dispositivos_vistos = set()

    for particao in psutil.disk_partitions(all=False):
        dispositivo = particao.device

        if dispositivo in dispositivos_vistos:
            continue

        dispositivos_vistos.add(dispositivo)

        try:
            uso = psutil.disk_usage(particao.mountpoint)

            total_bytes += uso.total
            usado_bytes += uso.used

        except (PermissionError, OSError):
            continue

    if total_bytes == 0:
        return 0.0

    return round(
        (usado_bytes / total_bytes) * 100,
        2,
    )


def main():
    print("=" * 60)
    print("MONIT ORE - CAPTURA DE HARDWARE E PROCESSOS")
    print("=" * 60)

    # Identifica o PC pelo hostname local.
    # Nenhuma consulta ao banco de dados e realizada aqui.
    identificador_pc_industrial = socket.gethostname().strip()

    if not identificador_pc_industrial:
        raise ValueError(
            "Nao foi possivel identificar o hostname deste PC."
        )

    print(f"Hostname local: {identificador_pc_industrial}")

    print(
        "A torre e a mineradora serao identificadas "
        "posteriormente pelo tratamento.py."
    )

    # Valida os arquivos antes de escrever.
    validar_arquivo_csv(
        ARQUIVO_HARDWARE,
        CABECALHO_HARDWARE,
    )

    validar_arquivo_csv(
        ARQUIVO_PROCESSOS,
        CABECALHO_PROCESSOS,
    )

    escrever_cabecalho_hw = precisa_cabecalho(
        ARQUIVO_HARDWARE
    )

    escrever_cabecalho_proc = precisa_cabecalho(
        ARQUIVO_PROCESSOS
    )

    processadores_virtuais = (
        psutil.cpu_count(logical=True) or 1
    )

    try:
        with open(
            ARQUIVO_HARDWARE,
            "a",
            newline="",
            encoding="utf-8-sig",
        ) as arquivo_hw, open(
            ARQUIVO_PROCESSOS,
            "a",
            newline="",
            encoding="utf-8-sig",
        ) as arquivo_proc:

            escritor_hw = csv.writer(
                arquivo_hw,
                delimiter=";",
            )

            escritor_proc = csv.writer(
                arquivo_proc,
                delimiter=";",
            )

            if escrever_cabecalho_hw:
                escritor_hw.writerow(CABECALHO_HARDWARE)
                arquivo_hw.flush()

            if escrever_cabecalho_proc:
                escritor_proc.writerow(CABECALHO_PROCESSOS)
                arquivo_proc.flush()

            for numero_rodada in range(
                1,
                TOTAL_REGISTROS_LIMITE + 1,
            ):
                # Coleta o uso total da CPU durante um segundo.
                cpu_total_pct = psutil.cpu_percent(
                    interval=1
                )

                # Coleta o uso total da memoria RAM.
                memoria = psutil.virtual_memory()

                ram_total_pct = memoria.percent

                ram_total_mb = round(
                    memoria.total / (1024 * 1024),
                    2,
                )

                # Coleta o percentual de uso do disco.
                disco_total_pct = obter_uso_disco()

                # Mantem a data no formato dia/mes/ano.
                agora = datetime.now()

                data = agora.strftime("%d/%m/%Y")
                hora = agora.strftime("%H:%M:%S")

                # Coleta os processos ativos.
                linhas_processos = obter_processos(
                    numero_rodada,
                    identificador_pc_industrial,
                    data,
                    hora,
                    processadores_virtuais,
                )

                qtd_processos = len(linhas_processos)

                # Monta a linha de hardware.
                linha_hardware = [
                    numero_rodada,
                    identificador_pc_industrial,
                    data,
                    hora,
                    round(cpu_total_pct, 2),
                    round(ram_total_pct, 2),
                    ram_total_mb,
                    disco_total_pct,
                    qtd_processos,
                ]

                # Grava os dados nos arquivos CSV.
                escritor_hw.writerow(linha_hardware)
                escritor_proc.writerows(linhas_processos)

                # Garante que os dados sejam gravados a cada rodada.
                arquivo_hw.flush()
                arquivo_proc.flush()

                print(
                    f"Rodada {numero_rodada}/"
                    f"{TOTAL_REGISTROS_LIMITE} concluida | "
                    f"CPU: {cpu_total_pct:.2f}% | "
                    f"RAM: {ram_total_pct:.2f}% | "
                    f"Disco: {disco_total_pct:.2f}% | "
                    f"Processos: {qtd_processos}"
                )

                if numero_rodada < TOTAL_REGISTROS_LIMITE:
                    time.sleep(INTERVALO_SEGUNDOS)

    except KeyboardInterrupt:
        print("\nCaptura interrompida manualmente.")

    print("=" * 60)
    print("Captura finalizada.")
    print(f"Hardware: {ARQUIVO_HARDWARE}")
    print(f"Processos: {ARQUIVO_PROCESSOS}")
    print("=" * 60)

if __name__ == "__main__":
    main()